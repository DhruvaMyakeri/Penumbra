# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Reactor — required. Used for the X2 video editor and the cosmos-nano-policy-droid VLA.
REACTOR_API_KEY=

# Gemini — optional. Powers the scenario director, the render agent, and the intent
# judge. Without it the suite still runs, but only on hand-written fault specs.
GEMINI_API_KEY=
